  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^7.9.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.2"
