{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@bhairava/domain": ["../domain/src/index.ts"],
      "@bhairava/design-tokens": ["../design-tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
