# PRODUCTION environment contract ? NEVER commit real values.
# Never reuse development/staging/demo secrets. Never set Demo@12345.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://PROD_USER:PROD_PASSWORD@PROD_HOST:5432/bhairava?schema=public&sslmode=require
REDIS_URL=rediss://PROD_REDIS_HOST:6379

JWT_ACCESS_SECRET=REPLACE_WITH_32PLUS_RANDOM_PRODUCTION_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_32PLUS_RANDOM_PRODUCTION_REFRESH
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=none

PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_UNIQUE_TO_PRODUCTION_________

S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=REPLACE_PROD_S3_KEY
S3_SECRET_KEY=REPLACE_PROD_S3_SECRET
S3_BUCKET=bhairava-prod
S3_REGION=ap-south-1

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
JSON_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=10485760

CORS_ORIGINS=https://admin.example.com,https://agent.example.com,https://customer.example.com
ADMIN_WEB_URL=https://admin.example.com
AGENT_WEB_URL=https://agent.example.com
CUSTOMER_WEB_URL=https://customer.example.com
API_PUBLIC_URL=https://api.example.com
MOBILE_API_URL=https://api.example.com

# Founder bootstrap (one-time). Requires ALLOW_FOUNDER_BOOTSTRAP=yes
# FOUNDER_EMAIL=founder@yourco.com
# FOUNDER_PASSWORD=set-a-strong-unique-password-12plus
# FOUNDER_ORG_NAME=Your Company
# FOUNDER_ORG_CODE=YOURCO
# ALLOW_FOUNDER_BOOTSTRAP=yes

# NEVER set ALLOW_DEMO_SEED in production.
