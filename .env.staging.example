# STAGING environment contract ? NEVER reuse development/demo secrets.
# Copy to services/api/.env and services/worker/.env for staging only.

NODE_ENV=staging
PORT=4000

DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/bhairava_staging?schema=public
REDIS_URL=redis://STAGING_REDIS_HOST:6379

JWT_ACCESS_SECRET=REPLACE_WITH_32PLUS_RANDOM_STAGING_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_32PLUS_RANDOM_STAGING_REFRESH
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=none

PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_UNIQUE_TO_STAGING____________

S3_ENDPOINT=https://s3.staging.example.com
S3_ACCESS_KEY=REPLACE_STAGING_S3_KEY
S3_SECRET_KEY=REPLACE_STAGING_S3_SECRET
S3_BUCKET=bhairava-staging
S3_REGION=ap-south-1

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
JSON_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=10485760

# Distinct web origins (comma-separated allowlist)
CORS_ORIGINS=https://admin.staging.example.com,https://agent.staging.example.com,https://customer.staging.example.com
ADMIN_WEB_URL=https://admin.staging.example.com
AGENT_WEB_URL=https://agent.staging.example.com
CUSTOMER_WEB_URL=https://customer.staging.example.com
API_PUBLIC_URL=https://api.staging.example.com
MOBILE_API_URL=https://api.staging.example.com

# Optional external channels ? missing = BLOCKED BY EXTERNAL CREDENTIAL
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_PROVIDER_API_KEY=
# FCM_SERVER_KEY=
# EXPO_ACCESS_TOKEN=

# Staging may seed demo personas ONLY with explicit allow:
# ALLOW_DEMO_SEED=yes
# NODE_ENV must NOT be production when seeding
