# Root reference — copy into services/api/.env and services/worker/.env
# Never commit real secrets. See docs/ENVIRONMENT.md

NODE_ENV=development
PORT=4000

# Postgres (docker compose default)
DATABASE_URL=postgresql://bhairava:bhairava@localhost:5432/bhairava?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# JWT — min 32 chars; replace before any shared/staging/prod use
JWT_ACCESS_SECRET=change-me-access-dev-only-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-dev-only-32chars-min
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
COOKIE_SECURE=false

# PII AES-256-GCM key — 64 hex chars (32 bytes)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object storage (MinIO local / S3 prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bhairava
S3_REGION=us-east-1

# Rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Founder bootstrap (packages/database/prisma/bootstrap/founder.ts only)
# FOUNDER_EMAIL=founder@yourco.com
# FOUNDER_PASSWORD=set-a-strong-password
# FOUNDER_ORG_NAME=Your Company
# FOUNDER_ORG_CODE=YOURCO
